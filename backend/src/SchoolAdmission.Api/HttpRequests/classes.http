@host = http://localhost:5070

### List all classes with seat counts -> 200 OK
GET {{host}}/classes
Accept: application/json

### Create a class -> 201 Created
# @name createClass
POST {{host}}/classes
Content-Type: application/json

{
  "name": "Class 7 - Morning Shift",
  "totalSeats": 130
}

### Get a class by id -> 200 OK (replace with a real id from the list)
GET {{host}}/classes/c09d9936-1022-4f23-8425-ceb44d2436c9
Accept: application/json

### Unknown class id -> 404 Not Found
GET {{host}}/classes/00000000-0000-0000-0000-000000000000
Accept: application/json

### Same name again -> 409 Conflict
POST {{host}}/classes
Content-Type: application/json

{
  "name": "Class 6 - Morning Shift",
  "totalSeats": 50
}

### Empty name -> 400 Bad Request
POST {{host}}/classes
Content-Type: application/json

{
  "name": "",
  "totalSeats": 120
}

### Zero seats -> 400 Bad Request
POST {{host}}/classes
Content-Type: application/json

{
  "name": "Class 7 - Day Shift",
  "totalSeats": 0
}

### Negative seats -> 400 Bad Request
POST {{host}}/classes
Content-Type: application/json

{
  "name": "Class 8 - Day Shift",
  "totalSeats": -5
}

### Missing totalSeats -> 400 Bad Request
POST {{host}}/classes
Content-Type: application/json

{
  "name": "Class 9 - Day Shift"
}

### Name longer than 200 characters -> 400 Bad Request
POST {{host}}/classes
Content-Type: application/json

{
  "name": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
  "totalSeats": 10
}
